{
  "name": "@avatrain/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ws": {
      "types": "./dist/realtime/ws-messages.d.ts",
      "default": "./dist/realtime/ws-messages.js"
    },
    "./auth": {
      "types": "./dist/auth/schemas.d.ts",
      "default": "./dist/auth/schemas.js"
    },
    "./tutor": {
      "types": "./dist/tutor/index.d.ts",
      "default": "./dist/tutor/index.js"
    },
    "./onboarding": {
      "types": "./dist/onboarding/index.d.ts",
      "default": "./dist/onboarding/index.js"
    },
    "./org": {
      "types": "./dist/org/index.d.ts",
      "default": "./dist/org/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "default": "./dist/knowledge/index.js"
    },
    "./curriculum": {
      "types": "./dist/curriculum/index.d.ts",
      "default": "./dist/curriculum/index.js"
    },
    "./avatar": {
      "types": "./dist/avatar/index.d.ts",
      "default": "./dist/avatar/index.js"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "default": "./dist/application/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "@xenova/transformers": "^2.17.2",
    "echogarden": "^3.0.5",
    "google-auth-library": "^11.0.0",
    "msedge-tts": "^2.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
