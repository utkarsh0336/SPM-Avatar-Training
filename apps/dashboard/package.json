{
  "name": "@avatrain/dashboard",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../../.env node_modules/next/dist/bin/next dev",
    "dev:clean": "pnpm run clean && pnpm run dev",
