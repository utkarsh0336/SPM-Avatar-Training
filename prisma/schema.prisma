generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataRegion {
  US
  EU
}

enum Role {
  OWNER
  MEMBER
}

enum UserStatus {
  ACTIVE
  PENDING
}

/// Tenant root. Not itself org-scoped — everything else hangs off org_id.
model Organization {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  dataRegion DataRegion   @default(US) @map("data_region")
  createdAt  DateTime     @default(now()) @map("created_at")

  applications Application[]
  memberships  Membership[]
  sessions     Session[]

  @@map("organizations")
}

/// Tenant-scoped. org_id + RLS policy required — see prisma/migrations and
/// .claude/rules/tenancy.md.
model Application {
  id              String       @id @default(uuid()) @db.Uuid
  orgId           String       @map("org_id") @db.Uuid
  name            String
  publishableKey  String       @unique @map("publishable_key")
  createdAt       DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("applications")
}

/// Global identity root — not tenant-scoped, same reasoning as Organization
/// itself (credentials aren't tenant business data). Exempt from RLS; see
/// scripts/verify-rls.mjs EXEMPT_TABLES.
model User {
  id                   String     @id @default(uuid()) @db.Uuid
  email                String     @unique
  passwordHash         String?    @map("password_hash")
  status               UserStatus @default(ACTIVE)
  inviteTokenHash      String?    @unique @map("invite_token_hash")
  inviteTokenExpiresAt DateTime?  @map("invite_token_expires_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

/// Tenant-scoped. org_id + RLS policy required — see prisma/migrations and
/// .claude/rules/tenancy.md.
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Tenant-scoped. org_id + RLS policy required — see prisma/migrations and
/// .claude/rules/tenancy.md. Opaque session token; only its SHA-256 hash is
/// ever persisted (see packages/shared/src/auth/tokens.ts).
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}
