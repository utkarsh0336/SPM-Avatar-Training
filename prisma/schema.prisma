generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataRegion {
  US
  EU
}

/// Minimal plan tier, set manually (ops / prisma studio) — no self-serve
/// upgrade flow or Stripe linkage exists yet (that's a future billing
/// spec). Exists so Mode B (LiveKit) can be gated to ENTERPRISE orgs only,
/// per CLAUDE.md's "LiveKit only for enterprise avatar mode" — see
/// .claude/specs/real-time-video-avatar-interaction.md.
enum OrganizationPlan {
  STARTER
  PRO
  ENTERPRISE
}

/// PARTNER added by .claude/specs/partner-role.md — read-only, scoped to
/// Curriculum.programType === PARTNER_ENABLEMENT (training-catalog.md).
/// requireRole(role) stays an exact-match single-role check; see
/// apps/api/src/plugins/auth.ts's requireAnyRole for the "one of several"
/// case this role introduces.
enum Role {
  OWNER
  MEMBER
  PARTNER
}

enum UserStatus {
  ACTIVE
  PENDING
}

enum OAuthProvider {
  GOOGLE
}

enum AvatarStyle {
  REALISTIC
  ANIMATED
  STYLIZED_3D
}

enum AvatarGender {
  FEMALE
  MALE
  NEUTRAL
}

enum HairStyle {
  SHORT
  MEDIUM
  LONG
  CURLY
  WAVY
  BALD
}

enum Outfit {
  BUSINESS_FORMAL
  BUSINESS_CASUAL
  SMART_PROFESSIONAL
  TECH_CREATIVE
  ACADEMIC_EDUCATOR
}

enum Expertise {
  HR_LEAVE_POLICY
  SALES_NEGOTIATION
  COMPLIANCE_LEGAL
  PRODUCT_TRAINING
  CUSTOMER_SUPPORT
  LEADERSHIP_MANAGEMENT
  FINANCE_ACCOUNTING
  IT_TECHNOLOGY
  MARKETING_BRANDING
}

enum VoiceTone {
  DEEP
  NEUTRAL
  WARM
}

/// Additive avatar-configuration attribute — see SOW §3.1 "various age groups".
/// Metadata only: never fed into replica-resolver.ts's model selection (same
/// convention as Expertise/VoiceTone below).
enum AgeGroup {
  YOUNG_ADULT
  MIDDLE_AGED
  SENIOR
}

/// Additive avatar-configuration attribute — see SOW §3.1 "regional ...
/// avatars". Distinct from Organization.dataRegion (data residency, not
/// avatar appearance/audience). Metadata only, same convention as AgeGroup.
enum AvatarRegion {
  GLOBAL
  INDIA
  NORTH_AMERICA
  EUROPE
  MIDDLE_EAST
  APAC
}

/// Additive avatar-configuration attribute — see SOW §3.1 "... language-
/// specific avatars". Deliberately its own enum rather than reusing
/// tutor/avatar-config.ts's languageSchema ("English"/"Hindi"/"Spanish", used
/// in the ephemeral WS session.start message) — SCREAMING_CASE values match
/// every other avatar enum here, keeping avatar-service.ts's/onboarding-
/// service.ts's generic patch passthrough free of a value-casing mapping.
/// Trainer-set, audience-wide; resolved server-side into the session's
/// Language via tutor/avatar-config.ts's resolveSessionLanguage — see
/// .claude/specs/multi-language-support.md.
enum AvatarLanguage {
  ENGLISH
  HINDI
  SPANISH
}

/// Additive avatar-configuration attribute. Unlike AgeGroup/AvatarRegion (metadata only), this one
/// is actually consumed — see tutor/system-prompt.ts's buildSystemPrompt and its
/// READING_LEVEL_INSTRUCTION map. Trainer-set, audience-wide; not a per-learner preference — see
/// .claude/specs/adaptive-learning-personalization.md's Scope decisions. AvatarLanguage above is
/// also consumed (see its own doc comment), not metadata-only either.
enum ReadingLevel {
  SIMPLE
  STANDARD
  ADVANCED
}

enum AvatarStatus {
  DRAFT
  ACTIVE
  /// Soft-deleted, not removed — Curriculum.avatarId is a required @unique
  /// FK with no onDelete behavior specified, so a hard DELETE on an avatar
  /// with a curriculum would throw a raw FK-violation. Archiving instead
  /// preserves the curriculum and all ObjectiveProgress history and just
  /// excludes the avatar from pickers/session-start/embed config.
  ARCHIVED
}

/// Additive — reserved for an optional, free avatar-generation vendor. NONE
/// is the only value the default onboarding flow ever writes; READY_PLAYER_ME
/// is only written by the flag-gated "Generate 3D Avatar" step. See
/// .claude/specs/avatar-builder-customization.md.
enum AvatarPreviewProvider {
  NONE
  READY_PLAYER_ME
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

/// Owned by .claude/specs/interactive-assessment.md.
enum ObjectiveProgressVerdict {
  PASS
  RETRY
}

/// Owned by .claude/specs/training-catalog.md — the content-taxonomy/
/// audience-targeting layer interactive-assessment.md's Scope decisions
/// explicitly deferred ("audience/program-type tagging... deferred to a
/// follow-up Training Catalog spec"). One value per Curriculum, not per
/// Objective — see that spec's Scope decisions.
enum ProgramType {
  EMPLOYEE_ONBOARDING
  COMPLIANCE_TRAINING
  CUSTOMER_EDUCATION
  PARTNER_ENABLEMENT
}

/// Tenant root. Not itself org-scoped — everything else hangs off org_id.
model Organization {
  id                String           @id @default(uuid()) @db.Uuid
  name              String
  dataRegion        DataRegion       @default(US) @map("data_region")
  plan              OrganizationPlan @default(STARTER)
  // Additive branding fields — see .claude/specs/tenant-branding.md. All
  // nullable: an org that never sets them renders with the product's
  // existing hardcoded defaults, never breaks.
  logoUrl           String?          @map("logo_url")
  primaryColorHex   String?          @map("primary_color_hex")
  secondaryColorHex String?          @map("secondary_color_hex")
  createdAt         DateTime         @default(now()) @map("created_at")

  applications            Application[]
  memberships             Membership[]
  sessions                Session[]
  avatars                 Avatar[]
  knowledgeDocuments      KnowledgeDocument[]
  knowledgeChunks         KnowledgeChunk[]
  curricula               Curriculum[]
  objectives              Objective[]
  objectiveProgresses     ObjectiveProgress[]
  scenarioSteps           ScenarioStep[]
  scenarioBranches        ScenarioBranch[]
  inductionChecklists     InductionChecklist[]
  checklistItems          ChecklistItem[]
  checklistItemProgresses ChecklistItemProgress[]
  trainingSessions        TrainingSession[]
  messages                Message[]
  trainingSessionPins     TrainingSessionPin[]

  @@map("organizations")
}

/// Tenant-scoped. org_id + RLS policy required — see prisma/migrations and
/// .claude/rules/tenancy.md.
/// A single embeddable widget configuration — an org creates one Application
/// per third-party site/embed it wants to run, each with its own
/// publishableKey, allowed origins, and pinned avatar. No secret key: the
/// public surface (apps/api/src/routes/embed.ts) only ever needs the
/// publishable key, never privileged server-to-server access. See
/// .claude/rules/embed.md.
model Application {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  name           String
  publishableKey String   @unique @map("publishable_key")
  /// Exact-string origin allowlist (e.g. "https://example.com") — checked
  /// against the request's Origin header by embed.ts before minting a
  /// ticket or returning config. Never a wildcard/prefix match.
  allowedOrigins String[] @default([]) @map("allowed_origins")
  /// The persona this embed renders — nullable so an Application can be
  /// created before an avatar exists yet; embed.ts 503s until it's set.
  avatarId       String?  @map("avatar_id") @db.Uuid
  /// Kill switch without rotating the key — embed.ts checks this first.
  isEnabled      Boolean  @default(true) @map("is_enabled")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  avatar       Avatar?      @relation(fields: [avatarId], references: [id])

  @@index([orgId])
  @@map("applications")
}

/// Admin-portal chrome locale — see .claude/specs/dashboard-localization.md.
/// Deliberately its own enum rather than reusing AvatarLanguage
/// (ENGLISH/HINDI): that enum drives the learner-facing avatar's
/// conversation language; this one drives the trainer/admin's own UI
/// language, a different concern that lives on User, not Avatar/Org.
enum UiLocale {
  EN
  HI
}

/// Global identity root — not tenant-scoped, same reasoning as Organization
/// itself (credentials aren't tenant business data). Exempt from RLS; see
/// scripts/verify-rls.mjs EXEMPT_TABLES.
model User {
  id                    String     @id @default(uuid()) @db.Uuid
  email                 String     @unique
  passwordHash          String?    @map("password_hash")
  status                UserStatus @default(ACTIVE)
  inviteTokenHash       String?    @unique @map("invite_token_hash")
  inviteTokenExpiresAt  DateTime?  @map("invite_token_expires_at")
  // Owned by Authentication, consumed by the (separately specced) onboarding
  // wizard gate — see .claude/specs/onboarding.md "Depends On".
  onboardingCompletedAt DateTime?  @map("onboarding_completed_at")
  // Personal admin-portal chrome preference, not a tenant-wide setting — see
  // .claude/specs/dashboard-localization.md. Additive/defaulted so every
  // existing user backfills to EN with no behavior change.
  uiLocale              UiLocale   @default(EN) @map("ui_locale")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  memberships             Membership[]
  sessions                Session[]
  oauthAccounts           OAuthAccount[]
  objectiveProgresses     ObjectiveProgress[]
  checklistItemProgresses ChecklistItemProgress[]
  trainingSessions        TrainingSession[]
  trainingSessionPins     TrainingSessionPin[]

  @@map("users")
}

/// Global identity root, same reasoning as User — not tenant-scoped. Exempt
/// from RLS; see scripts/verify-rls.mjs EXEMPT_TABLES.
model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  email             String
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Tenant-scoped. org_id + RLS policy required — see prisma/migrations and
/// .claude/rules/tenancy.md.
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Tenant-scoped. org_id + RLS policy required — see prisma/migrations and
/// .claude/rules/tenancy.md. Opaque session token; only its SHA-256 hash is
/// ever persisted (see packages/shared/src/auth/tokens.ts).
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md.
/// Owned by .claude/specs/onboarding.md (core fields) and additively extended
/// by .claude/specs/avatar-builder-customization.md (preview fields).
model Avatar {
  id          String @id @default(uuid()) @db.Uuid
  orgId       String @map("org_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid

  name              String?
  style             AvatarStyle?
  gender            AvatarGender?
  // Plain String + application-layer allowlist (SKIN_TONE_TOKENS /
  // HAIR_COLOR_TOKENS in packages/shared), not a Postgres enum — lets the
  // palette change without a migration. See onboarding.md's Database Changes.
  skinTone          String?         @map("skin_tone")
  hairStyle         HairStyle?      @map("hair_style")
  hairColor         String?         @map("hair_color")
  outfit            Outfit?
  expertise         Expertise?
  voice             VoiceTone?
  // Additive — see AgeGroup/AvatarRegion doc comments above. Metadata only,
  // never completion-required (assertAvatarComplete doesn't reference these)
  // and never fed into replica-resolver.ts.
  ageGroup          AgeGroup?       @map("age_group")
  region            AvatarRegion?
  // Additive, like ageGroup/region, but actually consumed — resolved server-side into the
  // session's Language, see AvatarLanguage's own doc comment above.
  preferredLanguage AvatarLanguage? @map("preferred_language")
  // Additive, like ageGroup/region, but actually consumed by buildSystemPrompt — see the
  // ReadingLevel enum's doc comment above.
  readingLevel      ReadingLevel?   @map("reading_level")

  status          AvatarStatus @default(DRAFT)
  lastVisitedStep Int          @default(1) @map("last_visited_step")

  // Additive: optional realistic-preview generation. Never required by
  // completion validation — see avatar-builder-customization.md §Database.
  previewProvider    AvatarPreviewProvider @default(NONE) @map("preview_provider")
  externalAvatarId   String?               @map("external_avatar_id")
  avatarModelUrl     String?               @map("avatar_model_url")
  avatarSnapshotUrl  String?               @map("avatar_snapshot_url")
  previewGeneratedAt DateTime?             @map("preview_generated_at")

  // Resolved server-side from gender (resolveSimliFaceId in
  // apps/api/src/lib/simli.ts, keyed by SIMLI_FACE_ID_FEMALE/MALE/NEUTRAL
  // with a fallback to the base SIMLI_FACE_ID) — set at draft creation
  // (gender still null then, so it resolves to the base fallback) and
  // recomputed by onboarding-service.ts's updateDraft whenever gender
  // changes, so the builder's live preview and the real training session
  // are provably the same face for whichever gender is currently selected.
  // Simli's API exposes no way to list/browse alternate faces for an
  // account (verified live: GET /faces returns only account-owned custom
  // faces) — these are public/default-library face ids provided directly.
  // True per-selection personalization beyond gender (skin tone, hair, etc.)
  // would need either more account faces or a photo-upload +
  // custom-face-creation flow, neither built yet.
  simliFaceId String? @map("simli_face_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [orgId], references: [id])
  curriculum       Curriculum?
  applications     Application[]
  trainingSessions TrainingSession[]

  @@index([orgId])
  @@index([orgId, createdById, status])
  @@map("avatars")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md.
/// Owned by .claude/specs/knowledge-management.md. One uploaded source file
/// (SOP, policy, manual, ...) that gets parsed, chunked, and embedded into
/// KnowledgeChunk rows. status tracks the async ingestion pipeline; the raw
/// file itself lives outside Postgres (see apps/api's DocumentStorage
/// adapter), addressed here only by storageKey.
model KnowledgeDocument {
  id           String @id @default(uuid()) @db.Uuid
  orgId        String @map("org_id") @db.Uuid
  uploadedById String @map("uploaded_by_id") @db.Uuid

  title            String
  originalFilename String @map("original_filename")
  mimeType         String @map("mime_type")
  fileSizeBytes    Int    @map("file_size_bytes")
  storageKey       String @map("storage_key")

  status       KnowledgeDocumentStatus @default(PENDING)
  errorMessage String?                 @map("error_message")
  chunkCount   Int                     @default(0) @map("chunk_count")

  category String?  @db.VarChar(100)
  tags     String[] @default([])

  // Version control (.claude/specs/knowledge-document-lifecycle.md): rows
  // sharing lineageId are versions of "the same document". isLatest flips
  // only on ingestion success (see knowledge-service.ts's
  // setLatestVersion()), never at upload time, so grounding never goes dark
  // mid-processing or on a failed re-upload.
  lineageId String  @default(uuid()) @map("lineage_id") @db.Uuid
  version   Int     @default(1)
  isLatest  Boolean @default(true) @map("is_latest")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [orgId], references: [id])
  chunks       KnowledgeChunk[]

  @@unique([lineageId, version])
  @@index([orgId])
  @@index([orgId, category])
  @@map("knowledge_documents")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md.
/// Owned by .claude/specs/knowledge-management.md. orgId is denormalized
/// from the parent KnowledgeDocument (not joined for RLS/retrieval) so both
/// the RLS policy and retrieval-service's similarity search filter on an
/// indexed column directly, matching every other tenant-scoped table here.
/// embedding is Unsupported — pgvector has no native Prisma type, so all
/// reads/writes on it go through $queryRaw/$executeRaw (see
/// apps/api/src/services/retrieval-service.ts and knowledge-service.ts).
/// vector(384) matches the default local embedding provider's output
/// dimension (Xenova/all-MiniLM-L6-v2) — switching embedding providers to a
/// different dimension requires a migration and a full re-embed.
model KnowledgeChunk {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid

  chunkIndex Int                        @map("chunk_index")
  content    String
  embedding  Unsupported("vector(384)")
  tokenCount Int                        @map("token_count")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [orgId], references: [id])
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md. Owned by
/// .claude/specs/interactive-assessment.md. One curriculum per Avatar (1:1) — the smallest
/// structure that makes start_checkpoint/grade_answer/record_progress/end_module meaningful.
/// Multi-curriculum-per-avatar and avatar-agnostic curricula are deferred — see the spec's
/// "Scope decisions".
model Curriculum {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  avatarId    String       @unique @map("avatar_id") @db.Uuid
  createdById String       @map("created_by_id") @db.Uuid
  title       String
  // Additive, nullable — see .claude/specs/training-catalog.md. null means
  // "uncategorized", the same state every curriculum created before this
  // field existed is in; never backfilled.
  programType ProgramType? @map("program_type")
  // Trainer opt-in: when true, getCurriculumForAvatar presents this curriculum's objectives to
  // each learner in mastery-weighted order instead of strict authored `order`. Default false so
  // every curriculum created before this field existed keeps today's behavior unchanged — see
  // .claude/specs/adaptive-learning-paths.md.
  adaptiveOrderingEnabled Boolean @default(false) @map("adaptive_ordering_enabled")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [orgId], references: [id])
  avatar       Avatar              @relation(fields: [avatarId], references: [id])
  objectives   Objective[]
  checklist    InductionChecklist?

  @@index([orgId])
  @@index([orgId, programType])
  @@map("curricula")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md. Owned by
/// .claude/specs/interactive-assessment.md. orgId denormalized from Curriculum, same reasoning as
/// KnowledgeChunk (RLS and lookups filter on an indexed column directly, no join needed). One
/// teachable, checkable unit within a Curriculum.
model Objective {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  curriculumId    String   @map("curriculum_id") @db.Uuid
  order           Int
  title           String
  teachingContent String   @map("teaching_content")
  checkQuestion   String   @map("check_question")
  gradingCriteria String   @map("grading_criteria")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [orgId], references: [id])
  curriculum    Curriculum          @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  progress      ObjectiveProgress[]
  scenarioSteps ScenarioStep[]

  @@unique([curriculumId, order])
  @@index([orgId])
  @@index([curriculumId])
  @@map("objectives")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md. Owned by
/// .claude/specs/interactive-assessment.md. Server-only writes — record_progress is serverOnly
/// per .claude/rules/tenancy.md. Never written from a route driven by request-body input; only
/// from conversation-service's tool dispatcher, fed by grade_answer's own server-computed verdict
/// for the SAME turn (never a verdict argument supplied by the model). One row per
/// (objective, learner) — upserted on every grade_answer + record_progress pair.
model ObjectiveProgress {
  id          String                   @id @default(uuid()) @db.Uuid
  orgId       String                   @map("org_id") @db.Uuid
  objectiveId String                   @map("objective_id") @db.Uuid
  learnerId   String                   @map("learner_id") @db.Uuid
  verdict     ObjectiveProgressVerdict
  attempts    Int                      @default(1)
  feedback    String
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  objective    Objective    @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  learner      User         @relation(fields: [learnerId], references: [id])

  @@unique([objectiveId, learnerId])
  @@index([orgId])
  @@index([learnerId])
  @@map("objective_progress")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md. Owned by
/// .claude/specs/branching-scenario-questions.md. Optional, ordered branching step attached to an
/// Objective. When an Objective has zero ScenarioSteps it behaves exactly as
/// interactive-assessment.md defined (flat checkQuestion/gradingCriteria) — those fields stay
/// required and untouched either way; this is additive, not a replacement.
model ScenarioStep {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  objectiveId String   @map("objective_id") @db.Uuid
  order       Int
  prompt      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization     Organization     @relation(fields: [orgId], references: [id])
  objective        Objective        @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  branchesFromHere ScenarioBranch[] @relation("BranchFromStep")
  branchesToHere   ScenarioBranch[] @relation("BranchToStep")

  @@unique([objectiveId, order])
  @@index([orgId])
  @@index([objectiveId])
  @@map("scenario_steps")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md. Owned by
/// .claude/specs/branching-scenario-questions.md. One branch out of a ScenarioStep.
/// matchCriteria is judged the same way Objective.gradingCriteria is — an LLM judge call, never
/// the model self-reporting which branch matched. Exactly one of (nextStepId, outcome) is set:
/// nextStepId continues the scenario; outcome (reusing ObjectiveProgressVerdict — no new parallel
/// enum) terminates it and feeds record_progress exactly like grade_answer's verdict does today.
model ScenarioBranch {
  id            String                    @id @default(uuid()) @db.Uuid
  orgId         String                    @map("org_id") @db.Uuid
  fromStepId    String                    @map("from_step_id") @db.Uuid
  order         Int
  matchCriteria String                    @map("match_criteria")
  nextStepId    String?                   @map("next_step_id") @db.Uuid
  outcome       ObjectiveProgressVerdict?
  createdAt     DateTime                  @default(now()) @map("created_at")

  organization Organization  @relation(fields: [orgId], references: [id])
  fromStep     ScenarioStep  @relation("BranchFromStep", fields: [fromStepId], references: [id], onDelete: Cascade)
  nextStep     ScenarioStep? @relation("BranchToStep", fields: [nextStepId], references: [id])

  @@unique([fromStepId, order])
  @@index([orgId])
  @@index([fromStepId])
  @@map("scenario_branches")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md. Owned by
/// .claude/specs/induction-checklist.md. One optional checklist per Curriculum (nullable 1:1,
/// mirroring Curriculum's own 1:1-per-Avatar shape) — a structured, non-conversational set of
/// tasks a learner checks off directly, distinct from Objective's AI-graded checkpoints. Not the
/// same concept as .claude/specs/onboarding.md's trainer-facing avatar-configuration wizard.
model InductionChecklist {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  curriculumId String   @unique @map("curriculum_id") @db.Uuid
  createdById  String   @map("created_by_id") @db.Uuid
  title        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [orgId], references: [id])
  curriculum   Curriculum      @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  items        ChecklistItem[]

  @@index([orgId])
  @@map("induction_checklists")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md. Owned by
/// .claude/specs/induction-checklist.md. orgId denormalized from InductionChecklist, same
/// reasoning as Objective. One discrete, self-attested task within a checklist.
model ChecklistItem {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  checklistId String   @map("checklist_id") @db.Uuid
  order       Int
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [orgId], references: [id])
  checklist    InductionChecklist      @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  progress     ChecklistItemProgress[]

  @@unique([checklistId, order])
  @@index([orgId])
  @@index([checklistId])
  @@map("checklist_items")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md. Owned by
/// .claude/specs/induction-checklist.md. Self-attested completion — the learner clicking "done",
/// not a server-graded verdict like ObjectiveProgress — so completedAt is written by a plain
/// authenticated endpoint, never the serverOnly tool-call machinery record_progress uses.
/// completedAt null means not completed; set means completed. One row per (item, learner).
model ChecklistItemProgress {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  itemId      String    @map("item_id") @db.Uuid
  learnerId   String    @map("learner_id") @db.Uuid
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [orgId], references: [id])
  item         ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  learner      User          @relation(fields: [learnerId], references: [id])

  @@unique([itemId, learnerId])
  @@index([orgId])
  @@index([learnerId])
  @@map("checklist_item_progress")
}

/// Owned by .claude/specs/video-chat-session.md (Milestone 2). VIDEO_CHAT backs
/// apps/dashboard/app/sessions; VOICE_ONLY backs apps/dashboard/app/voice-ai — both dashboard
/// trees hit the identical GET /v1/conversations/:trainingSessionId/ws route, so one
/// kind-discriminated model serves both instead of duplicating schema/RLS/CRUD.
enum TrainingSessionKind {
  VIDEO_CHAT
  VOICE_ONLY
}

enum TrainingSessionStatus {
  ACTIVE
  ENDED
}

enum MessageRole {
  USER
  AVATAR
  SYSTEM
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md. Owned by
/// .claude/specs/video-chat-session.md (Milestone 2). Server-minted id — this IS the
/// `trainingSessionId` apps/api/src/routes/conversations.ts's WS route and
/// apps/api/src/lib/livekit.ts's room naming key off of, replacing the earlier
/// client-generated slug (`session-${Date.now()}`/`voice-${Date.now()}`), which had no
/// persisted-ownership record and was guarded only by an in-memory Map.
model TrainingSession {
  id              String                @id @default(uuid()) @db.Uuid
  orgId           String                @map("org_id") @db.Uuid
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  clientRequestId String                @map("client_request_id")

  kind   TrainingSessionKind
  status TrainingSessionStatus @default(ACTIVE)
  title  String
  topic  String?

  // Exactly one of avatarId/voiceExpertId is set, matching kind — enforced at the service layer
  // (training-session-service.ts), not expressible as a direct Prisma/DB constraint.
  avatarId String? @map("avatar_id") @db.Uuid
  // Not a FK — an id into packages/shared/src/training-session/voice-experts.ts's static catalog,
  // which is code, not tenant data (no VoiceExpert table exists).
  voiceExpertId String? @map("voice_expert_id")
  // Denormalized at creation from the resolved Avatar (name/expertiseTopicTitle) or voice expert
  // (name/role), server-side — never trusted from the client. VOICE_ONLY rows have no Avatar row
  // to join at read time, and this mirrors the denormalization convention already used by both
  // Milestone-1 mock fixtures this table replaces (listOwnerName/listCategory, expertName/expertRole).
  personaName String @map("persona_name")
  personaRole String @map("persona_role")

  endReason String?   @map("end_reason")
  endedAt   DateTime? @map("ended_at")

  createdAt DateTime @default(now()) @map("created_at")
  // Bumped on every persisted Message too (see conversation-service.ts's
  // persistTrainingSessionMessage) so "recent" list ordering reflects real activity with no
  // separate heartbeat mechanism.
  updatedAt DateTime @updatedAt @map("updated_at")

  organization  Organization         @relation(fields: [orgId], references: [id])
  createdByUser User                 @relation(fields: [createdByUserId], references: [id])
  avatar        Avatar?              @relation(fields: [avatarId], references: [id])
  messages      Message[]
  pins          TrainingSessionPin[]

  @@unique([orgId, clientRequestId])
  @@index([orgId, kind, status])
  @@index([orgId, kind, updatedAt])
  @@map("training_sessions")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md. One row per
/// finalized conversation turn. Server-write-only — there is no public POST .../messages route;
/// rows are inserted only from conversation-service.ts's trusted realtime pipeline
/// (persistTrainingSessionMessage), matching this rule file's "record_progress/grade_answer are
/// serverOnly, server re-checks entitlement rather than trusting model arguments" posture.
/// content is passed through redact() (packages/shared/src/redact.ts) before insert — that
/// function is still a no-op stub, flagged to security-reviewer, not silently shipped as if PII
/// scrubbing were real.
model Message {
  id                String @id @default(uuid()) @db.Uuid
  orgId             String @map("org_id") @db.Uuid
  trainingSessionId String @map("training_session_id") @db.Uuid

  role      MessageRole
  content   String      @db.Text
  sequence  Int
  createdAt DateTime    @default(now()) @map("created_at")

  organization    Organization    @relation(fields: [orgId], references: [id])
  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  @@unique([trainingSessionId, sequence])
  @@index([orgId, trainingSessionId])
  @@map("messages")
}

/// Tenant-scoped. org_id + RLS policy required — see .claude/rules/tenancy.md. Per-(user,
/// TrainingSession) pin; row existence = pinned, unpin deletes the row. Deliberately NOT a
/// `pinned` boolean column on TrainingSession itself — the session list is org-wide (matches
/// listCurricula/listApplications's convention), so a column there would make one trainer's pin
/// globally visible/toggleable by every other org member, which is wrong; pin is genuinely
/// per-(user, session). Replaces .claude/specs/video-chat-session.md's draft
/// `UserSessionPreference` — that model's other fields (lastMuted/lastCameraOff/lastLanguage/
/// transcriptVisible) are pure client-side useState in TrainingSessionContext.tsx/
/// VoiceSessionUiContext.tsx today, never sent to the server anywhere in this codebase, so only
/// the field that's actually needed is built.
model TrainingSessionPin {
  id                String @id @default(uuid()) @db.Uuid
  orgId             String @map("org_id") @db.Uuid
  userId            String @map("user_id") @db.Uuid
  trainingSessionId String @map("training_session_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  organization    Organization    @relation(fields: [orgId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  @@unique([userId, trainingSessionId])
  @@index([orgId])
  @@map("training_session_pins")
}
