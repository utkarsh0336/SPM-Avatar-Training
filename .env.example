# Postgres
DATABASE_URL=postgresql://avatrain:avatrain@localhost:5433/avatrain

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI Realtime — server-only, never exposed to the browser
OPENAI_API_KEY=

# LiveKit (enterprise avatar mode, apps/agent)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Knowledge Management (document ingestion + RAG retrieval)
# EMBEDDING_PROVIDER: "local" (default, free, self-hosted, no key needed) or
# "openai" (uses OPENAI_API_KEY above — a placeholder for when the org
# approves a paid embedding provider, see .claude/specs/knowledge-management.md)
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=
# Absolute path for uploaded document storage. Defaults to
# ./.data/knowledge-documents under the repo root if unset.
KNOWLEDGE_STORAGE_DIR=
